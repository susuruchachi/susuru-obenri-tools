<?xml version="1.0" encoding="utf-8"?>
<!-- 貸し借り帳のウィジェット：返ってくる予定・返す予定、相手ごとの差し引き、届いた「返したよ」。押すとアプリが開く -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="⚓ 貸し借り帳" android:textSize="14sp" android:textStyle="bold" android:textColor="#E3C384"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="10sp" android:textColor="#5E7180" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/widget_cell" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="返ってくる予定" android:textSize="10sp" android:textColor="#97A8B5" />
            <TextView android:id="@+id/w_in" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="18sp" android:textStyle="bold" android:textColor="#7FB69E"
                android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
        <View android:layout_width="8dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/widget_cell" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="返す予定" android:textSize="10sp" android:textColor="#97A8B5" />
            <TextView android:id="@+id/w_out" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textSize="18sp" android:textStyle="bold" android:textColor="#E08A84"
                android:fontFamily="monospace" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_claims" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#131E29" android:background="@drawable/widget_claim" android:paddingLeft="8dp" android:paddingRight="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />

    <TextView android:id="@+id/w_lines" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:text="タップしてアプリを開くと、ここに貸し借りが出ます" android:textSize="13sp"
        android:textColor="#EDE6D2" android:lineSpacingExtra="2dp" android:ellipsize="end" />
</LinearLayout>
