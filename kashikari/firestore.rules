rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /kashikari_books/{bookId} {
      function kkSignedIn() { return request.auth != null; }
      function kkBook() { return get(/databases/$(database)/documents/kashikari_books/$(bookId)).data; }
      function kkMember() { return kkSignedIn() && request.auth.uid in kkBook().members; }
      function kkOnlyMyName() {
        return request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names[request.auth.uid] is string
          && request.resource.data.names[request.auth.uid].size() <= 20;
      }

      allow get: if kkSignedIn();
      allow list: if kkSignedIn() && request.auth.uid in resource.data.members;
      allow create: if kkSignedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'createdAt'])
        && request.resource.data.names.keys().hasOnly([request.auth.uid]);
      allow update: if kkSignedIn() && (
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && kkOnlyMyName())
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && kkOnlyMyName())
        || (resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40)
      );

      match /loans/{loanId} {
        allow read: if kkMember();
        allow create: if kkMember() && request.resource.data.lender == request.auth.uid;
        allow update: if kkMember() && resource.data.lender == request.auth.uid && request.resource.data.lender == request.auth.uid;
        allow delete: if kkMember() && resource.data.lender == request.auth.uid;
      }

      match /claims/{claimId} {
        allow read: if kkMember();
        allow create: if kkMember()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.lender != request.auth.uid
          && get(/databases/$(database)/documents/kashikari_books/$(bookId)/loans/$(request.resource.data.loanId)).data.lender == request.resource.data.lender;
        allow update: if kkMember()
          && resource.data.lender == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status in ['approved', 'rejected'];
        allow delete: if kkMember() && (resource.data.from == request.auth.uid || resource.data.lender == request.auth.uid);
      }
    }

    match /kashikari_private/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
